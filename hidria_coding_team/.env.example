# =============================================================================
# HIDRIA — inventario de variables del equipo (SIN VALORES REALES)
# =============================================================================
# Este archivo documenta TODAS las variables que usan los 8 agentes y dónde vive
# cada secreto. NUNCA completar valores reales aquí: el repo es público.
# Valores reales: `C:\Proyectos\hidria\.env` (gitignored) o secret stores.
# =============================================================================

# ------------------------- Desarrollo local --------------------------------
# (raíz del repo / app Vite)
VITE_SUPABASE_URL=                 # URL pública del proyecto Supabase (dev/staging sintético)
VITE_SUPABASE_ANON_KEY=            # clave anon pública (segura para el cliente)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=              # solo para `supabase db push` local/CI
SUPABASE_PROJECT_REF=              # zucalshlfcxejpukshxl

# ------------------------- Solo servidor / CI ------------------------------
# NUNCA se empaqueta en el cliente ni se commitea.
SUPABASE_SERVICE_ROLE_KEY=         # .env local, secrets de EF y CI
GITHUB_TOKEN=                      # MCP GitHub / CI (solo .env)
CLOUDFLARE_API_TOKEN=              # wrangler (solo .env)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE=                   # vacío: se usa *.pages.dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCS=hidria-docs
R2_BUCKET_REPORTS=hidria-reports

# ------------------------- Feature flags -----------------------------------
NOM151_ENABLED=false               # EF-13 (Fase 3)

# ------------------------- Secretos de Edge Functions ----------------------
# Se configuran con `supabase secrets set`; NUNCA en el repo.
# SUPABASE_SERVICE_ROLE_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# PSC_* (NOM-151), NOM151_ENABLED

# ------------------------- GitHub Actions (repository secrets) -------------
# SUPABASE_ACCESS_TOKEN       (para `supabase link`/`db push` en CI)
# SUPABASE_DB_PASSWORD
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (build del cliente)

# ------------------------- Regla de oro ------------------------------------
# service_role: jamás en app/, jamás en VITE_*, jamás en un commit.
