# =============================================================================
# HIDRIA — plantilla de variables de entorno (SIN VALORES REALES)
# =============================================================================
# Copiar a `.env` (NUNCA versionar) y completar con las credenciales del entorno.
# Este archivo SÍ se versiona: aquí solo van nombres y valores públicos de ejemplo.
# El repositorio es PÚBLICO: ninguna clave real puede aparecer aquí.
# =============================================================================

# --- GitHub ---------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=horaciomartinez-svg/hidria-ect

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: SOLO Edge Functions / CI / .env local. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# --- Cliente (Vite: se empaquetan en el build; solo clave anon) -----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudflare -----------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Vacío mientras no haya zona propia: se usa URL *.pages.dev
CLOUDFLARE_ZONE=

# --- Cloudflare R2 --------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCS=hidria-docs
R2_BUCKET_REPORTS=hidria-reports

# --- Feature flags / integraciones ---------------------------------------
# Firma NOM-151 (EF-13): false hasta Fase 3
NOM151_ENABLED=false
